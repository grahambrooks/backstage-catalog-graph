{
  "name": "backstage-catalog-graph",
  "displayName": "Backstage Catalog Graph",
  "description": "Visualise a Backstage catalog-info.yaml as the catalog graph it describes, with placeholders for external references.",
  "version": "2026.10.18",
  "publisher": "grahambrooks",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "backstage",
    "catalog-info",
    "software catalog",
    "graph",
    "idp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/grahambrooks/backstage-catalog-graph.git",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/grahambrooks/backstage-catalog-graph#readme",
  "bugs": {
    "url": "https://github.com/grahambrooks/backstage-catalog-graph/issues"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "backstageCatalogGraph.showToSide",
        "title": "Show Catalog Graph to the Side",
        "category": "Backstage",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "backstageCatalogGraph.show",
        "title": "Show Catalog Graph",
        "category": "Backstage"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "backstageCatalogGraph.showToSide",
          "when": "backstageCatalogGraph.isCatalogFile",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "backstageCatalogGraph.showToSide",
          "when": "backstageCatalogGraph.isCatalogFile"
        },
        {
          "command": "backstageCatalogGraph.show",
          "when": "backstageCatalogGraph.isCatalogFile"
        }
      ],
      "explorer/context": [
        {
          "command": "backstageCatalogGraph.show",
          "when": "resourceFilename =~ /^(.*\\.)?catalog-info\\.ya?ml$|^catalog-(all|entities)\\.ya?ml$/",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "Backstage Catalog Graph",
      "properties": {
        "backstageCatalogGraph.showExternalReferences": {
          "type": "boolean",
          "default": true,
          "description": "Draw placeholder nodes for entities referenced by the file but declared elsewhere."
        },
        "backstageCatalogGraph.ownersAsBadges": {
          "type": "boolean",
          "default": true,
          "description": "Show each entity's owner as a badge on the entity instead of drawing an ownedBy edge to it."
        },
        "backstageCatalogGraph.rebuildDelayMs": {
          "type": "number",
          "default": 350,
          "minimum": 0,
          "maximum": 5000,
          "description": "How long to wait after a keystroke before redrawing the graph."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "bundle": "node esbuild.mjs",
    "bundle:production": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "test": "npm run compile && node --test \"out-test/test/**/*.test.js\"",
    "package": "vsce package --out backstage-catalog-graph-$npm_package_version.vsix",
    "vscode:prepublish": "npm run bundle:production"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2"
  }
}
